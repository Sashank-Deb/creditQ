{
  "name": "creditq",
  "private": true,
  "description": "CreditQ: privacy-first credit card bill reminders. All user data stays on the device.",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "sharp": "0.35.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
